PORT=5000
uriDB=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/ecommerce
BASE_URL=http://localhost:5000
JWT_SECRET_KEY=change-me-to-a-long-random-string
JET_EXPIRED_TIME=1d
NODE_ENV=development

# SMTP (only needed for the forgot-password email). Use Ethereal for testing.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-pass
SMTP_EMAIL=your-ethereal-user@ethereal.email

# Stripe (only needed for card payments)
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
